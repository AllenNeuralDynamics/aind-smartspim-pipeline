# Deployment configuration — edit this file for your cluster/environment.
# Do NOT commit this file (it is in .gitignore); copy it from deployment.env.example.
#
# Usage: this file is sourced by submit_pipeline_to_slurm.sh automatically.
#        Capsule versions are managed separately in environment/versions.env.

# ── Paths ────────────────────────────────────────────────────────────────────

# Absolute path to the root of this repository on the cluster filesystem
PIPELINE_PATH="/your/repo-pipeline/path"

# Path to the raw SmartSPIM dataset (the folder containing SPIM/, acquisition.json, etc.)
DATA_PATH="/path/to/your/data"

# Path where Nextflow writes its run logs and reports
RESULTS_PATH="/path/to/your/outputs"

# Nextflow work directory (intermediate files; can be on scratch storage)
WORKDIR="/path/to/workdir"

# ── Pipeline parameters ───────────────────────────────────────────────────────

# Where processed results are written. Use an S3 path (s3://bucket/key) when CLOUD=true.
OUTPUT_PATH="/path/to/your/outputdir"

# Path to the CCF / SmartSPIM template volume
TEMPLATE_PATH="/path/to/templatev2"

# Path to the cell-detection model weights directory
CELL_MODELS_PATH="/path/to/production-models"

# Set to "true" to upload results to S3 after each stage; "false" for local output only
CLOUD="false"

# ── Optional pipeline settings ────────────────────────────────────────────────
# Uncomment and fill in as needed. Unset values fall back to the pipeline and
# dispatcher defaults.

# Raw-data root for channel splitting. The dispatcher looks for channels under
# <INPUT_PATH>/<data_description.name>/SPIM. Defaults to the parent folder of DATA_PATH;
# set it if your dataset folder name differs from data_description.json "name".
# In cloud mode, set it to the input S3 bucket name.
# INPUT_PATH=""

# NG_BASE_URL=""          # Neuroglancer base URL for result links
# CCF_ANNOTATION_S3=""    # S3 path to CCF annotation volume
# CO_DOMAIN=""            # CodeOcean org URL (e.g. https://codeocean.allenneuraldynamics.org)
# DATA_FOLDER=""          # Overrides the dispatcher's data folder (default: capsule/data)
# RESULTS_FOLDER=""       # Overrides the dispatcher's results folder (default: capsule/results)

# ── Optional dispatcher credentials and alerts ────────────────────────────────
# Exported to the dispatcher containers only when set. Leave unset to disable
# the feature. Keep this file private: it is in .gitignore for that reason.

# ALERT_BOT_LINK=""       # MS Teams webhook for pipeline alerts
# API_SECRET=""           # CodeOcean API token
# SES_TOKEN_PATH=""       # AWS Secrets Manager path for SES/Smartsheet credentials
# SMARTSHEET_ID=""        # Smartsheet ID for investigator contact lookup
# SOURCE_EMAIL=""         # SES-verified sender address for email alerts
